# =====================================================================
# Chaves GENÉRICAS de DESENVOLVIMENTO — servem para rodar localmente.
# NÃO use em produção. Antes de publicar na Play Store:
#   1. gere uma keystore própria e guarde-a FORA do repositório;
#   2. troque as senhas abaixo por senhas fortes (ou use variáveis do CI);
#   3. aponte MATILHA_KEYSTORE para o arquivo da keystore de produção.
# Se trocar a keystore, apague o volume "matilha_keys" (docker volume rm matilha_keys)
# e desinstale o app do celular antes de instalar o novo APK (assinatura diferente).
# =====================================================================
MATILHA_KEYSTORE=/keys/matilha-dev.keystore
MATILHA_KEYSTORE_PASSWORD=matilha-dev-store
MATILHA_KEY_ALIAS=matilha
MATILHA_KEY_DNAME=CN=Matilha Dev,O=Matilha,C=BR

# Porta do servidor que entrega o APK
PORT=8080
